# =============== Unity generated ===============
# Ignore the build and cache folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Asset meta data should be tracked
!/[Aa]ssets/**/*.meta

# User-specific files
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.svd
*.pdb
*.mdb
*.opendb
*.booproj

# OS generated files
.DS_Store
Thumbs.db

# Rider / JetBrains
.idea/
*.sublime*
.vscode/

# Android / Gradle
.gradle/
local.properties

# Logs
*.log

# Unity Cache Server
Library/UnityCache/

# Exclude build output
*.apk
*.aab
*.unitypackage

# LFS (if used) keep the .gitattributes aside
