<?xml version="1.0" encoding="utf-8"?>
<!--
  Sample app.manifest to enable Per-Monitor DPI Awareness (PerMonitorV2) for Windows builds.
  Place this file in your Unity project (e.g., Assets/Plugins/app.manifest) and then in Unity:
  - Open Player Settings -> Other Settings -> Configuration -> Custom Main Manifest
  - Point it to this manifest file (use the file selector)

  Note: Unity's build process will embed this manifest into the generated EXE. Behavior may vary by
  Windows version. Test on target Windows machines. Keep a backup of original manifest if needed.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" processorArchitecture="*" name="DestopDunge.app" type="win32"/>

  <description>DestopDunge - sample DPI-aware manifest</description>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Per-monitor v2 DPI awareness provides the best behavior on modern Windows. -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
